{
  "rules": {
    "stream-yours-hosts": {
      ".read": true,
      "$hostId": {
        ".write": true,
        ".validate": "newData.hasChildren(['id', 'name', 'updatedAt'])",
        "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "items": {
          "$i": {
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "path": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "size": { ".validate": "newData.isNumber()" },
            "sizeLabel": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "type": { ".validate": "newData.isString() && (newData.val() === 'file' || newData.val() === 'folder')" },
            "count": { ".validate": "newData.isNumber()" },
            "episodes": {
              "$e": {
                ".validate": "newData.hasChildren(['id', 'name'])",
                "id": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "name": { ".validate": "newData.isString() && newData.val().length <= 400" },
                "path": { ".validate": "newData.isString() && newData.val().length <= 1000" },
                "size": { ".validate": "newData.isNumber()" },
                "sizeLabel": { ".validate": "newData.isString() && newData.val().length <= 32" },
                "type": { ".validate": "newData.isString() && newData.val().length <= 16" },
                "$other": { ".validate": true }
              }
            },
            "$other": { ".validate": true }
          }
        },
        "$other": { ".validate": true }
      }
    },
    "stream-yours-signals": {
      "$hostId": {
        ".read": true,
        ".write": true,
        "$sessionKey": {
          "offer": {
            "sdp": { ".validate": "newData.isString() && newData.val().length < 30000" },
            "$other": { ".validate": true }
          },
          "answer": {
            "sdp": { ".validate": "newData.isString() && newData.val().length < 30000" },
            "$other": { ".validate": true }
          },
          "createdAt": { ".validate": "newData.isNumber()" },
          "hostCandidates": { "$c": { ".validate": "newData.hasChildren()" } },
          "viewerCandidates": { "$c": { ".validate": "newData.hasChildren()" } }
        }
      }
    }
  }
}
